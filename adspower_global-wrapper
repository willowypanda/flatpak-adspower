#!/bin/sh
set -e

export ELECTRON_DISABLE_SANDBOX=1
export CHROME_DEVEL_SANDBOX=""
export NODE_ENV=production
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.var/app/com.adspower.global/config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-${HOME}/.var/app/com.adspower.global/data}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-${HOME}/.var/app/com.adspower.global/cache}"

# AdsPower stores its profile data under Documents/Adspower by default.
mkdir -p "${HOME}/Documents/Adspower"

exec /app/opt/AdsPower_Global/adspower_global "$@"
